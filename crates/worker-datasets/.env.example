# ================================
# Service Configuration
# ================================
SERVICE_NAME=worker-datasets

# ================================
# NATS Configuration
# ================================
NATS_URL=nats://localhost:4222
# JetStream replica count (default: 3)
NATS_REPLICAS=3

# ================================
# Qdrant Vector Database Configuration
# ================================
# Connection details (URL, API key) come from the job payload.
# The variables below only tune client behavior.

# Request and connection timeouts (seconds)
QDRANT_TIMEOUT_SECS=30
QDRANT_CONNECT_TIMEOUT_SECS=10

# Max attempts to create a collection (default: 5)
QDRANT_COLLECTION_CREATE_MAX_ATTEMPTS=5

# Client/collection-existence cache sizing
QDRANT_CLIENT_CACHE_CAPACITY=128
QDRANT_COLLECTION_CACHE_CAPACITY=10000

# ================================
# Worker Configuration
# ================================
# Number of concurrent jobs (should match embedding capacity)
MAX_CONCURRENT_JOBS=8

# Health check server port (default: 8083)
HEALTH_CHECK_PORT=8083

# ================================
# Performance Tuning
# ================================
# Parallel Qdrant uploads - controls concurrent chunk uploads (default: 4)
QDRANT_PARALLEL_UPLOADS=4

# Max upsert passes over the set of failing chunks before giving up (default: 4)
QDRANT_UPSERT_MAX_ATTEMPTS=4

# ================================
# Embedding Configuration
# ================================
# Embedding Inference API URL
EMBEDDING_INFERENCE_API_URL=http://localhost:8090

# Embedding API request timeout in seconds (default: 120)
EMBEDDING_INFERENCE_API_TIMEOUT_SECS=120

# Max concurrent embedding API requests (should match GPU/inference capacity)
EMBEDDING_MAX_CONCURRENT_REQUESTS=1

# ================================
# Observability & Monitoring
# ================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LOG_FORMAT=json
RUST_LOG=worker_datasets=debug
